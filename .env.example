# Copy this file to .env and fill in real values
# NEVER commit .env to GitHub

# Database — use PostgreSQL with Docker or SQLite for local dev
DATABASE_URL=postgresql://mhd_user:mhd_pass@localhost:5432/mental_health_db
# DATABASE_URL=sqlite:///./mental_health_tracker.db

SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend URL (Next.js default)
FRONTEND_URL=http://localhost:3000

# SMTP for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

# Google OAuth (get these from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
